source "https://rubygems.org"

# Built by GitHub Actions (.github/workflows/pages.yml), not the classic
# github-pages gem, so versions are ours to choose. Gemfile.lock pins the
# exact versions for both the Action and the local preview container.
gem "jekyll", "~> 4.4"
gem "minima", "~> 2.5"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.18"
  gem "jekyll-seo-tag", "~> 2.9"
end

# Needed by `jekyll serve` on Ruby 3.x.
gem "webrick", "~> 1.9"
